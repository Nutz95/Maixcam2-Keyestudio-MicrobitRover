      "left_x": false,
      "right_x": false,
      "trigger_diff": false
    },
    "dpad": {
      "up": "forward",
      "down": "backward",
      "left": "strafe_left",
      "right": "strafe_right",
      "up_left": "diag_fl",
      "up_right": "diag_fr",
      "down_left": "diag_bl",
      "down_right": "diag_br"
    },
    "buttons": {
      "btn_a": "stop",
      "btn_b": null,
      "btn_x": null,
      "btn_y": null,
      "btn_lb": null,
      "btn_rb": null,
      "btn_start": null,
      "btn_select": null
    }
  },
  "evdev": {
    "layout": "maixcam_bt"
  }
